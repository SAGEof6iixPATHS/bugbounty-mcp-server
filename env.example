# Copy to .env. Never commit the populated file.

# Logging
LOG_LEVEL=INFO

# Scope is fail-closed while SAFE_MODE is true.
SAFE_MODE=true

# Exact apex and wildcard subdomains are separate scope entries.
# Replace these examples with assets you are explicitly authorized to test.
ALLOWED_TARGETS=
BLOCKED_TARGETS=

# Required in addition to an explicit private IP/CIDR allow rule for an internal lab.
ALLOW_PRIVATE_TARGETS=false

# Network pacing and hard limits
REQUESTS_PER_SECOND=5
DEFAULT_TIMEOUT=15
CONNECT_TIMEOUT=2
TOOL_TIMEOUT=300
MAX_TOOL_OUTPUT_CHARS=200000
MAX_CONCURRENT_SCANS=30
MAX_PORTS_PER_SCAN=1024
MAX_RESPONSE_BYTES=1000000
MAX_REDIRECTS=5
MAX_CRAWL_DEPTH=2
MAX_PAGES_TO_CRAWL=30
MAX_LINKS_PER_PAGE=1000
MAX_FORMS_PER_PAGE=200
MAX_DIRECTORY_REQUESTS=100
USER_AGENT=bugbounty-mcp-server/2.1 (+authorized-security-testing)

# Persistent local state
DATA_DIR=./data
OUTPUT_DIR=./output
MAX_EVIDENCE_BYTES=500000

# Optional pre-shared bearer authentication for Streamable HTTP. Use at least 24 random
# characters and transport it only over TLS. Stdio does not use this setting.
HTTP_BEARER_TOKEN=

# Optional operator-controlled wordlist. MCP callers cannot provide filesystem paths.
DIRECTORY_WORDLIST=

# Optional external scanner; disabled by default.
ENABLE_NUCLEI=false
NUCLEI_PATH=nuclei

# Example external bug bounty scope:
# ALLOWED_TARGETS=example.com,*.example.com
# REQUESTS_PER_SECOND=2

# Example isolated internal lab:
# ALLOWED_TARGETS=10.20.0.0/16
# ALLOW_PRIVATE_TARGETS=true
